# ── Stripe ──
# Get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# V1 messaging-first marketplace: listing Stripe Checkout off unless both are true.
# Server flag alone authorizes new listing charges. Public flag only hides/shows UI.
# Unset or any value other than "true" = disabled.
STRIPE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=false

# ── Firebase ──
# Get these from Firebase Console > Project Settings > General > Your apps > Web
# Required for local dev if the hardcoded fallback API key has HTTP referrer restrictions.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check — reCAPTCHA v3 site key (public). Must match provider in Firebase Console → App Check.
# If Console uses reCAPTCHA Enterprise, also set NEXT_PUBLIC_APP_CHECK_ENTERPRISE=true
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# NEXT_PUBLIC_APP_CHECK_ENTERPRISE=false
# Local debug token (Firebase Console → App Check → Manage debug tokens):
# NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=
# Skip App Check entirely (local dev only):
# NEXT_PUBLIC_DISABLE_APP_CHECK=true
GEMINI_API_KEY=

# ── Āwhina / Sky AI (REQUIRED in Vercel Production — server-only, never NEXT_PUBLIC_) ──
# Without this, /api/sky-ai/status returns openaiConfigured:false and listing AI is broken.
OPENAI_API_KEY=
# gpt-4o-mini (default, cheaper) or gpt-4o for closer ChatGPT quality
# OPENAI_MODEL=gpt-4o

# ── Āwhina vision listings (camera / photo → identify → listing conversation) ──
# BOTH required for end-to-end. Server flag alone authorizes /api/awhina-vision.
# NEXT_PUBLIC_ is baked at build time (see next.config.ts) — redeploy after changing.
# Unset or any value other than "true" = disabled (photo upload works, no identify).
AWHINA_VISION_LISTINGS_ENABLED=true
NEXT_PUBLIC_AWHINA_VISION_LISTINGS_ENABLED=true

# ── Firebase Cloud Messaging (PWA Push Notifications) ──
# Get VAPID key from Firebase Console > Cloud Messaging > Web Push Certificate
NEXT_PUBLIC_FCM_VAPID_KEY=

# Firebase Admin service account JSON (for server-side push sending)
# Download from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then set this as a single-line JSON string
FIREBASE_SERVICE_ACCOUNT=

# ── Email (for Cloud Functions notifications) ──
# Set these via: firebase functions:config:set smtp.host="..." smtp.port="587" smtp.user="..." smtp.pass="..." smtp.from="noreply@yourdomain.com"
# Get SMTP credentials from Resend, SendGrid, Mailgun, or your email provider
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@skydrop.app

# ── App ──
# Your production URL (used for metadata, sitemap, emails)
NEXT_PUBLIC_URL=https://skydrop.co.nz

# ── Sentry Error Tracking ──
# Get these from https://skydrop.sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Admin Emails ──
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com

# Super admin emails (overrides first ADMIN_EMAILS entry for super admin role)
# Comma-separated list. Falls back to first ADMIN_EMAILS entry if not set.
SUPER_ADMIN_EMAILS=

# ── Notification Email ──
# Email address for system alerts (webhook failures, payment issues, etc.)
# Falls back to the first admin email if not set
NOTIFICATION_EMAIL=admin@example.com

# ── Admin Session Cookie ──
# A random secret used to sign admin session cookies
COOKIE_SECRET=

# ── Rate Limiting (Upstash Redis) ──
# Get these from https://console.upstash.com/redis
# Enables distributed rate limiting across all Vercel instances
# If not set, falls back to in-memory + Firestore rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot Protection (Cloudflare Turnstile) ──
# Get these from https://dash.cloudflare.com/?to=/:account/turnstile
# Protects signup, login, listing creation, messaging, reports, and disputes
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
