# ── Stripe ──
# Get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Firebase ──
# Get these from Firebase Console > Project Settings > General > Your apps > Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Gemini AI (optional, for AI listing detection) ──
GEMINI_API_KEY=

# ── Sky AI (ChatGPT via OpenAI API — server-only, never NEXT_PUBLIC_) ──
OPENAI_API_KEY=
# gpt-4o-mini (default, cheaper) or gpt-4o for closer ChatGPT quality
# OPENAI_MODEL=gpt-4o

# ── Firebase Cloud Messaging (PWA Push Notifications) ──
# Get VAPID key from Firebase Console > Cloud Messaging > Web Push Certificate
NEXT_PUBLIC_FCM_VAPID_KEY=

# Firebase Admin service account JSON (for server-side push sending)
# Download from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then set this as a single-line JSON string
FIREBASE_SERVICE_ACCOUNT=

# ── Email (for Cloud Functions notifications) ──
# Set these via: firebase functions:config:set smtp.host="..." smtp.port="587" smtp.user="..." smtp.pass="..." smtp.from="noreply@yourdomain.com"
# Get SMTP credentials from Resend, SendGrid, Mailgun, or your email provider
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@skydrop.app

# ── App ──
# Your production URL (used for metadata, sitemap, emails)
NEXT_PUBLIC_URL=https://skydrop.co.nz

# ── Sentry Error Tracking ──
# Get these from https://skydrop.sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Admin Emails ──
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com

# ── Notification Email ──
# Email address for system alerts (webhook failures, payment issues, etc.)
# Falls back to the first admin email if not set
NOTIFICATION_EMAIL=admin@example.com

# ── Cron Jobs ──
# Secret token for authenticating cron job requests (e.g. /api/cron/expire-offers)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Admin Session Cookie ──
# A random secret used to sign admin session cookies
COOKIE_SECRET=

# ── Test Login (Firebase Auth — dev / staging only) ──
# Shows "Test Login" on /login and uses Admin SDK + signInWithCustomToken.
# Required: FIREBASE_SERVICE_ACCOUNT (above). Enabled automatically in `npm run dev`.
# ENABLE_TEST_LOGIN=true
# TEST_EMAIL=test@skydrop.nz
# TEST_PASSWORD=TestPass123!
# NEXT_PUBLIC_ENABLE_TEST_LOGIN=true
