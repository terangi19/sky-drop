{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    ".next",
    "out",
    "build",
    "functions/lib",
    "app/lib/awhina-tests.ts",
    "app/api/awhina-intent/route.ts"
  ]
}
