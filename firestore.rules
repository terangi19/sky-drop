rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSeller() {
      return resource.data.sellerEmail == request.auth.token.email
        || resource.data.sellerId == request.auth.uid;
    }
    function isAuctionBidUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['currentBid', 'currentMaxBid', 'secondMaxBid', 'highestBidder', 'bidCount', 'auctionEndsAt', 'auctionExtended']);
    }
    function isAdmin() {
      return request.auth.token.admin == true
        || request.auth.token.email in get(/databases/$(database)/documents/config/adminEmails).data.emails;
    }
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    function isDisputeActive() {
      return resource.data.disputeStatus == "open"
        || resource.data.disputeStatus == "pending"
        || resource.data.disputeStatus == "under_review";
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && (isSeller()
          || (resource.data.saleType is string && resource.data.saleType.matches('auction.*') && isAuctionBidUpdate())
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if request.auth != null && isSeller();
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == profileId
        && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null
        && request.auth.uid == profileId;
    }

    match /messages/{messageId} {
      allow read: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.participants != null
        && request.auth.token.email in request.resource.data.participants;
      allow delete: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
    }

    match /purchases/{purchaseId} {
      allow read: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email);
      allow create: if request.auth != null
        && request.resource.data.buyerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email)
        // Block seller from setting status to "delivered" (only buyer can confirm receipt)
        && !(resource.data.sellerEmail == request.auth.token.email
          && request.resource.data.status == "delivered")
        // During active dispute, only allow changing disputeStatus field
        && (!isDisputeActive()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disputeStatus', 'updatedAt']));
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.targetEmail == request.auth.token.email;
      allow create: if request.auth != null
        && request.resource.data.targetEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.targetEmail == request.auth.token.email;
    }

    // Reviews: only real buyers can review, one per purchase
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.reviewerEmail == request.auth.token.email
        && request.resource.data.sellerEmail != request.auth.token.email
        && exists(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId))
        && get(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId)).data.buyerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.reviewerEmail == request.auth.token.email;
      allow delete: if request.auth != null
        && resource.data.reviewerEmail == request.auth.token.email;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && isEmailVerified();
      allow read: if request.auth != null && isAdmin();
    }

    match /tradePosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && isEmailVerified();
      allow update: if request.auth != null
        && (resource.data.sellerEmail == request.auth.token.email
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /typing/{typingId} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.participants != null
        && request.auth.token.email in request.resource.data.participants;
      allow update: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
      allow delete: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /drops/{dropId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /tradeShouts/{shoutId} {
      allow read: if true;
      allow create: if request.auth != null && isEmailVerified();
      allow delete: if request.auth != null
        && resource.data.by == request.auth.token.email;
    }

    match /sponsoredDrops/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /dropTokens/{tokenId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /followers/{docId} {
      allow read: if request.auth != null
        && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
    }

    match /dailyChallenges/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /listingQuestions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.askerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && (resource.data.askerEmail == request.auth.token.email
          || resource.data.listingSellerEmail == request.auth.token.email);
    }

    match /commissions/{commissionId} {
      allow read: if request.auth != null
        && (resource.data.referrerEmail == request.auth.token.email
          || resource.data.referredEmail == request.auth.token.email);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.referrerEmail == request.auth.token.email;
    }

    match /referralEvents/{eventId} {
      allow read: if request.auth != null
        && resource.data.referrerEmail == request.auth.token.email;
      allow create: if request.auth != null;
    }

    match /jobApplications/{applicationId} {
      allow read: if request.auth != null
        && (resource.data.employerEmail == request.auth.token.email
          || resource.data.applicantEmail == request.auth.token.email);
      allow create: if request.auth != null && isEmailVerified();
      allow update: if request.auth != null
        && resource.data.employerEmail == request.auth.token.email;
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
      allow delete: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /hustlerLinks/{linkId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.promoterId == request.auth.uid;
    }

    match /hustlerClicks/{clickId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    match /hustlerCommissions/{commissionId} {
      allow read: if request.auth != null
        && (resource.data.promoterId == request.auth.uid
          || resource.data.sellerId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /hustlerEvents/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    match /disputes/{disputeId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email
          || isAdmin());
      allow update: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email
          || isAdmin());
    }

    match /adminAuditLog/{entryId} {
      allow create: if request.auth != null && isAdmin();
      allow read: if request.auth != null && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
