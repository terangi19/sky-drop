rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSeller() {
      return resource.data.sellerEmail == request.auth.token.email
        || resource.data.sellerId == request.auth.uid;
    }
    function isAuctionBidUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['currentBid', 'currentMaxBid', 'secondMaxBid', 'highestBidder', 'bidCount', 'auctionEndsAt', 'auctionExtended']);
    }
    // Buyer checkout: hold listing for 15 minutes (see CheckoutModal / create-payment-intent)
    function isCheckoutReservationUpdate() {
      return request.auth != null
        && (!('status' in resource.data) || resource.data.status != 'sold')
        && request.resource.data.reservedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reservedAt', 'reservedBy']);
    }
    function isSkyAdminEmail() {
      return request.auth.token.email in ['rangitr16@gmail.com'];
    }
    function isAdmin() {
      return request.auth.token.admin == true
        || isSkyAdminEmail()
        || (exists(/databases/$(database)/documents/config/adminEmails)
          && request.auth.token.email in get(/databases/$(database)/documents/config/adminEmails).data.emails);
    }
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    function isDisputeActive() {
      return resource.data.disputeStatus == "open"
        || resource.data.disputeStatus == "pending"
        || resource.data.disputeStatus == "under_review";
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && (isSeller()
          || (resource.data.saleType is string && resource.data.saleType.matches('auction.*') && isAuctionBidUpdate())
          || isCheckoutReservationUpdate()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if request.auth != null && isSeller();
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == profileId
        && request.resource.data.email == request.auth.token.email;
      // Users can update their own profile, but CANNOT write KYC verdict fields —
      // those are server-only (Admin SDK via API routes).
      allow update: if request.auth != null
        && request.auth.uid == profileId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['kycStatus', 'kycReviewedAt', 'kycReviewedBy', 'kycBannedReason']);
    }

    // KYC submissions — ID photos and identity data.
    // NEVER readable by other users. Owner can create/read their own. Admin can read all. No client deletes.
    match /kycSubmissions/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isEmailVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      // Owner may update only to resubmit (status reset to pending), not to approve themselves.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['idImageUrl', 'selfieImageUrl', 'submittedAt', 'status'])
        && request.resource.data.status == 'pending';
      allow delete: if false; // no client deletes — admin only via server SDK
    }

    // Usernames reservation collection — used by runTransaction in saveProfile
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.participants != null
        && request.auth.token.email in request.resource.data.participants;
      allow delete: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
    }

    // Purchases: server-side writes via API routes + webhook.
    // Client may only update status/tracking — never sensitive/stripe fields.
    match /purchases/{purchaseId} {
      allow read: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email);
      allow create: if false; // server-only (Admin SDK / REST API in API routes)
      allow update: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email)
        // Only allow status/tracking/delivery fields from client; blocks everything else
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'deliveredAt', 'tracking', 'trackingNumber', 'updatedAt', 'reviewed'])
        // Seller cannot set delivered status (buyer confirms receipt)
        && !(resource.data.sellerEmail == request.auth.token.email
          && request.resource.data.status == "delivered")
        // During active dispute, only disputeStatus field may change
        && (!isDisputeActive()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disputeStatus', 'updatedAt']));
    }

    // Notifications: client may read own and mark as read.
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.targetEmail == request.auth.token.email;
      allow create: if request.auth != null
        && request.resource.data.targetEmail is string
        && request.resource.data.fromEmail is string
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.read == false
        && request.resource.data.targetEmail != request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.targetEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
    }

    // Reviews: only real buyers can review, one per purchase
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.reviewerEmail == request.auth.token.email
        && request.resource.data.sellerEmail != request.auth.token.email
        && exists(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId))
        && get(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId)).data.buyerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.reviewerEmail == request.auth.token.email;
      allow delete: if request.auth != null
        && resource.data.reviewerEmail == request.auth.token.email;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.reporterUserEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && (request.resource.data.type == 'user' || request.resource.data.type == 'listing');
      allow read: if request.auth != null
        && (isAdmin() || resource.data.reporterUserId == request.auth.uid);
      allow update, delete: if request.auth != null && isAdmin();
    }

    match /tradePosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && isEmailVerified();
      allow update: if request.auth != null
        && (resource.data.sellerEmail == request.auth.token.email
          || isCheckoutReservationUpdate()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /typing/{typingId} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.participants != null
        && request.auth.token.email in request.resource.data.participants;
      allow update: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
      allow delete: if request.auth != null
        && resource.data.participants != null
        && request.auth.token.email in resource.data.participants;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /drops/{dropId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /tradeShouts/{shoutId} {
      allow read: if true;
      allow create: if request.auth != null && isEmailVerified();
      allow delete: if request.auth != null
        && resource.data.by == request.auth.token.email;
    }

    match /sponsoredDrops/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /dropTokens/{tokenId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /followers/{docId} {
      allow read: if request.auth != null
        && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
    }

    match /dailyChallenges/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /listingQuestions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.askerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && (resource.data.askerEmail == request.auth.token.email
          || resource.data.listingSellerEmail == request.auth.token.email);
    }

    match /commissions/{commissionId} {
      allow read: if request.auth != null
        && (resource.data.referrerEmail == request.auth.token.email
          || resource.data.referredEmail == request.auth.token.email);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.referrerEmail == request.auth.token.email;
    }

    match /referralEvents/{eventId} {
      allow read: if request.auth != null
        && resource.data.referrerEmail == request.auth.token.email;
      allow create: if request.auth != null;
    }

    match /jobApplications/{applicationId} {
      allow read: if request.auth != null
        && (resource.data.employerEmail == request.auth.token.email
          || resource.data.applicantEmail == request.auth.token.email);
      allow create: if request.auth != null && isEmailVerified();
      allow update: if request.auth != null
        && resource.data.employerEmail == request.auth.token.email;
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow create: if request.auth != null
        && isEmailVerified()
        && request.resource.data.sellerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
      allow delete: if request.auth != null
        && resource.data.sellerEmail == request.auth.token.email;
    }

    match /hustlerLinks/{linkId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.promoterId == request.auth.uid;
    }

    match /hustlerClicks/{clickId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    match /hustlerCommissions/{commissionId} {
      allow read: if request.auth != null
        && (resource.data.promoterId == request.auth.uid
          || resource.data.sellerId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /hustlerEvents/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    match /disputes/{disputeId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email
          || isAdmin());
      allow update: if request.auth != null
        && (resource.data.buyerEmail == request.auth.token.email
          || resource.data.sellerEmail == request.auth.token.email
          || isAdmin());
    }

    match /adminAuditLog/{entryId} {
      allow create: if request.auth != null && isAdmin();
      allow read: if request.auth != null && isAdmin();
    }

    match /skyAiConversations/{conversationId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/skyAiConversations/$(conversationId)).data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
