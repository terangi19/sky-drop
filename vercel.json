{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-offers",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/expire-auctions",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/cleanup-trade-shouts",
      "schedule": "40 13 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  }
}
