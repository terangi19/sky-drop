/**
 * Follow-up conversation tests
 */
export function createFollowUpTests(): TestCase[] {
  return [
    {
      name: "Price refinement",
      description: "Should refine search with price constraint",
      test: async () => {
        const start = Date.now();
        try {
          const memory = new ConversationMemory();
          memory.addUserTurn("show BMWs", "marketplace_search", { query: "BMW" });
          memory.addAssistantTurn("Here are BMW listings", {
            tool: "searchListings",
            args: { searchListings: { query: "BMW" } },
          });

          const result = await classifyIntent("under $15k", {
            pathname: "/search",
            conversationHistory: memory.getRecentHistory(),
          });

          const passed = result.intent === "marketplace_search";
          return {
            passed,
            message: passed ? "Price refinement classified correctly" : `Intent: ${result.intent}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Location refinement",
      description: "Should refine search with location constraint",
      test: async () => {
        const start = Date.now();
        try {
          const memory = new ConversationMemory();
          memory.addUserTurn("show phones", "marketplace_search", { query: "phones" });
          memory.addAssistantTurn("Here are phone listings", {
            tool: "searchListings",
            args: { searchListings: { query: "phones" } },
          });

          const result = await classifyIntent("only Auckland", {
            pathname: "/search",
            conversationHistory: memory.getRecentHistory(),
          });

          const passed = result.intent === "marketplace_search";
          return {
            passed,
            message: passed ? "Location refinement classified correctly" : `Intent: ${result.intent}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
  ];
}

