/**
 * Āwhina Automated Tests - GPT-Style Architecture
 * 
 * Automated tests for navigation, search, listing creation, follow-up conversations,
 * messaging, purchases, edge cases, and ambiguous commands.
 */

// Note: These tests are designed to be run in a proper TypeScript/Node environment
// The imports below are commented out to allow the file to be parsed

// import { classifyIntent } from "./awhina-intent-router";
// import { tryLocalExecution } from "./awhina-local-execution";
// import { executeToolCall } from "./awhina-tool-registry";
// import { ConversationMemory } from "./awhina-conversation-memory";
// import { evaluateConfidence } from "./awhina-confidence-scoring";

export type TestCase = {
  name: string;
  description: string;
  test: () => Promise<TestResult>;
};

export type TestResult = {
  passed: boolean;
  message: string;
  duration: number;
  error?: Error;
};

export type TestSuite = {
  name: string;
  tests: TestCase[];
  results: TestResult[];
  summary: {
    total: number;
    passed: number;
    failed: number;
    duration: number;
  };
};

/**
 * Test runner for Āwhina
 */
export class AwhinaTestRunner {
  private suites: TestSuite[] = [];

  registerSuite(name: string, tests: TestCase[]): void {
    this.suites.push({
      name,
      tests,
      results: [],
      summary: {
        total: 0,
        passed: 0,
        failed: 0,
        duration: 0,
      },
    });
  }

  async runAll(): Promise<TestSuite[]> {
    for (const suite of this.suites) {
      await this.runSuite(suite);
    }
    return this.suites;
  }

  async runSuite(suite: TestSuite): Promise<void> {
    const startTime = Date.now();

    for (const test of suite.tests) {
      const result = await test.test();
      suite.results.push(result);

      if (result.passed) {
        suite.summary.passed++;
      } else {
        suite.summary.failed++;
      }
      suite.summary.total++;
    }

    suite.summary.duration = Date.now() - startTime;
  }

  getSummary(): { total: number; passed: number; failed: number; duration: number } {
    return this.suites.reduce(
      (acc, suite) => ({
        total: acc.total + suite.summary.total,
        passed: acc.passed + suite.summary.passed,
        failed: acc.failed + suite.summary.failed,
        duration: acc.duration + suite.summary.duration,
      }),
      { total: 0, passed: 0, failed: 0, duration: 0 }
    );
  }
}

/**
 * Navigation tests
 */
export function createNavigationTests(): TestCase[] {
  return [
    {
      name: "Navigate to home",
      description: "Should classify 'home' as navigation intent",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("home", { pathname: "/messages" });
          const passed = result.intent === "navigation" && result.confidence === "high";
          return {
            passed,
            message: passed ? "Home navigation classified correctly" : `Got intent: ${result.intent}, confidence: ${result.confidence}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Navigate to sell page",
      description: "Should classify 'sell' as navigation intent",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("sell", { pathname: "/" });
          const passed = result.intent === "navigation" && result.confidence === "high";
          return {
            passed,
            message: passed ? "Sell navigation classified correctly" : `Got intent: ${result.intent}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Navigate to messages",
      description: "Should classify 'messages' as navigation intent",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("messages", { pathname: "/" });
          const passed = result.intent === "navigation" && result.confidence === "high";
          return {
            passed,
            message: passed ? "Messages navigation classified correctly" : `Got intent: ${result.intent}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
  ];
}

/**
 * Search tests
 */
export function createSearchTests(): TestCase[] {
  return [
    {
      name: "Search for BMW cars",
      description: "Should classify search query with entity extraction",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("find BMW cars under $15k", { pathname: "/" });
          const passed =
            result.intent === "marketplace_search" &&
            result.entities.some((e) => e.type === "price" && e.value === "15k");
          return {
            passed,
            message: passed ? "Search classified with price entity" : `Got intent: ${result.intent}, entities: ${JSON.stringify(result.entities)}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Search in Auckland",
      description: "Should extract location entity",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("show me items in Auckland", { pathname: "/" });
          const passed = result.entities.some((e) => e.type === "location" && e.value === "auckland");
          return {
            passed,
            message: passed ? "Location entity extracted" : `Entities: ${JSON.stringify(result.entities)}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
  ];
}

