/**
 * Edge case tests
 */
export function createEdgeCaseTests(): TestCase[] {
  return [
    {
      name: "Empty message",
      description: "Should handle empty message gracefully",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("", { pathname: "/" });
          const passed = result.intent === "unknown" && result.confidence === "low";
          return {
            passed,
            message: passed ? "Empty message handled correctly" : `Intent: ${result.intent}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Very long message",
      description: "Should handle long message",
      test: async () => {
        const start = Date.now();
        try {
          const longMessage = "I want to sell ".repeat(100) + "my car";
          const result = await classifyIntent(longMessage, { pathname: "/" });
          const passed = result.intent === "listing_create";
          return {
            passed,
            message: passed ? "Long message handled correctly" : `Intent: ${result.intent}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Special characters",
      description: "Should handle special characters",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("sell my car @ $500!", { pathname: "/" });
          const passed = result.intent === "listing_create";
          return {
            passed,
            message: passed ? "Special characters handled correctly" : `Intent: ${result.intent}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
  ];
}

/**
 * Ambiguous command tests
 */
export function createAmbiguousCommandTests(): TestCase[] {
  return [
    {
      name: "Ambiguous 'it'",
      description: "Should request clarification for ambiguous pronoun",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("how much is it?", { pathname: "/" });
          const confidenceEval = evaluateConfidence({
            intent: result.intent,
            entities: result.entities.reduce((acc, e) => ({ ...acc, [e.type]: e.value }), {}),
            message: "how much is it?",
            context: {
              hasConversationHistory: false,
              hasListingContext: false,
              currentPath: "/",
            },
          });

          const passed = confidenceEval.level === "low" && !!confidenceEval.clarificationQuestion;
          return {
            passed,
            message: passed ? "Ambiguous command flagged for clarification" : `Confidence: ${confidenceEval.level}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Typos in command",
      description: "Should handle typos gracefully",
      test: async () => {
        const start = Date.now();
        try {
          const result = await classifyIntent("go to hme", { pathname: "/" });
          const localResult = tryLocalExecution("go to hme", "/");
          const passed = result.intent === "navigation" || localResult.handled;
          return {
            passed,
            message: passed ? "Typo handled correctly" : `Intent: ${result.intent}, local: ${localResult.handled}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
  ];
}

/**
 * Local execution tests
 */
export function createLocalExecutionTests(): TestCase[] {
  return [
    {
      name: "Local command execution",
      description: "Should execute common commands locally",
      test: async () => {
        const start = Date.now();
        try {
          const result = tryLocalExecution("home", "/messages");
          const passed = result.handled && result.toolCall?.tool === "navigate";
          return {
            passed,
            message: passed ? "Local command executed" : `Handled: ${result.handled}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Local command cache",
      description: "Should cache local command results",
      test: async () => {
        const start = Date.now();
        try {
          const { tryLocalExecutionCached } = await import("./awhina-local-execution");
          const result1 = tryLocalExecutionCached("home", "/");
          const result2 = tryLocalExecutionCached("home", "/");
          const passed = result1.handled && result2.handled;
          return {
            passed,
            message: passed ? "Cache working" : "Cache failed",
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
  ];
}

/**
 * Tool execution tests
 */
export function createToolExecutionTests(): TestCase[] {
  return [
    {
      name: "Navigate tool execution",
      description: "Should execute navigate tool",
      test: async () => {
        const start = Date.now();
        try {
          const result = await executeToolCall({
            tool: "navigate",
            args: { navigate: { path: "/sell", reason: "Test" } },
            confidence: 1.0,
          });
          const passed = result.success;
          return {
            passed,
            message: passed ? "Navigate tool executed" : `Error: ${result.error}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
    {
      name: "Search tool execution",
      description: "Should execute search tool",
      test: async () => {
        const start = Date.now();
        try {
          const result = await executeToolCall({
            tool: "searchListings",
            args: { searchListings: { query: "BMW" } },
            confidence: 0.9,
          });
          const passed = result.success;
          return {
            passed,
            message: passed ? "Search tool executed" : `Error: ${result.error}`,
            duration: Date.now() - start,
          };
        } catch (error) {
          return {
            passed: false,
            message: "Test failed with error",
            duration: Date.now() - start,
            error: error as Error,
          };
        }
      },
    },
  ];
}

/**
 * Run all test suites
 */
export async function runAllAwhinaTests(): Promise<TestSuite[]> {
  const runner = new AwhinaTestRunner();

  runner.registerSuite("Navigation", createNavigationTests());
  runner.registerSuite("Search", createSearchTests());
  runner.registerSuite("Listing Creation", createListingCreationTests());
  runner.registerSuite("Follow-up Conversations", createFollowUpTests());
  runner.registerSuite("Messaging", createMessagingTests());
  runner.registerSuite("Purchases", createPurchaseTests());
  runner.registerSuite("Edge Cases", createEdgeCaseTests());
  runner.registerSuite("Ambiguous Commands", createAmbiguousCommandTests());
  runner.registerSuite("Local Execution", createLocalExecutionTests());
  runner.registerSuite("Tool Execution", createToolExecutionTests());

  return await runner.runAll();
}

/**
 * Print test results summary
 */
export function printTestSummary(suites: TestSuite[]): void {
  const summary = suites.reduce(
    (acc, suite) => ({
      total: acc.total + suite.summary.total,
      passed: acc.passed + suite.summary.passed,
      failed: acc.failed + suite.summary.failed,
      duration: acc.duration + suite.summary.duration,
    }),
    { total: 0, passed: 0, failed: 0, duration: 0 }
  );

  console.log("\n=== Āwhina Test Summary ===");
  console.log(`Total Tests: ${summary.total}`);
  console.log(`Passed: ${summary.passed}`);
  console.log(`Failed: ${summary.failed}`);
  console.log(`Duration: ${summary.duration}ms`);
  console.log(`Success Rate: ${((summary.passed / summary.total) * 100).toFixed(1)}%`);

  console.log("\n=== Suite Details ===");
  for (const suite of suites) {
    console.log(`\n${suite.name}:`);
    console.log(`  Total: ${suite.summary.total}`);
    console.log(`  Passed: ${suite.summary.passed}`);
    console.log(`  Failed: ${suite.summary.failed}`);
    console.log(`  Duration: ${suite.summary.duration}ms`);

    for (const result of suite.results) {
      const status = result.passed ? "✓" : "✗";
      console.log(`  ${status} ${result.message} (${result.duration}ms)`);
    }
  }
}
