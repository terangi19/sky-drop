{
  "name": "sky-drop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0 --webpack",
    "dev:turbo": "next dev --port 3000 --hostname 0.0.0.0 --turbo",
    "dev:clean": "node scripts/clean-dev-cache.cjs && next dev --port 3000 --hostname 0.0.0.0 --webpack",
    "build": "node scripts/check-drift.cjs && next build",
    "vercel-build": "node scripts/check-drift.cjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check:drift": "node scripts/check-drift.cjs",
    "check:drift:win": "node scripts/check-drift.cjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:awhina": "vitest run app/lib/sky-ai-evaluation.test.ts app/lib/sky-ai-conversation-stress.test.ts app/lib/sky-ai-task-replies.test.ts app/lib/sky-ai-find-routing.test.ts app/lib/sky-ai-find-e2e.test.ts app/lib/sky-ai-prompts.test.ts app/lib/awhina-canonical.test.ts app/lib/awhina-voice-command.test.ts app/lib/awhina-sell-profile.test.ts",
    "test:awhina:live": "vitest run app/lib/sky-ai-live-eval.test.ts",
    "test:awhina:smoke": "node scripts/smoke-awhina-manual.cjs",
    "test:awhina:live:compare": "cross-env SKY_AI_COMPARE_PRODUCTION=1 vitest run app/lib/sky-ai-live-eval.test.ts",
    "git:sync": "powershell -ExecutionPolicy Bypass -File scripts/git-sync.ps1"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.55.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/dompurify": "^3.0.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.11",
    "firebase": "^10.12.2",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "nsfwjs": "^4.3.0",
    "openai": "^6.42.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resend": "^4.2.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
