{
  "name": "sky-drop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0 --webpack",
    "dev:turbo": "next dev --port 3000 --hostname 0.0.0.0 --turbo",
    "dev:clean": "node scripts/clean-dev-cache.cjs && next dev --port 3000 --hostname 0.0.0.0 --webpack",
    "build": "node scripts/check-drift.cjs && next build",
    "vercel-build": "node scripts/check-drift.cjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check:drift": "node scripts/check-drift.cjs",
    "check:drift:win": "node scripts/check-drift.cjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:awhina": "vitest run app/lib/sky-ai-evaluation.test.ts app/lib/sky-ai-conversation-stress.test.ts app/lib/sky-ai-task-replies.test.ts app/lib/sky-ai-find-routing.test.ts app/lib/sky-ai-find-e2e.test.ts app/lib/sky-ai-prompts.test.ts app/lib/awhina-canonical.test.ts app/lib/awhina-voice-command.test.ts app/lib/awhina-sell-profile.test.ts app/lib/awhina-capability.test.ts app/lib/awhina-product-ux.test.ts app/lib/awhina-clarification-copy.test.ts app/lib/awhina-bmw-regression.test.ts app/lib/awhina-sell-oneshot.test.ts app/lib/awhina-premium-pass.test.ts app/lib/awhina-listing-description.test.ts app/lib/awhina-price-2007-regression.test.ts app/lib/awhina-decision.test.ts app/lib/awhina-benchmark.test.ts app/lib/awhina-compound-sell.test.ts app/lib/awhina-input-noise-regression.test.ts app/lib/awhina-pending-slot-canonical.test.ts app/lib/awhina-gen-repro.test.ts app/lib/awhina-vision-listing.test.ts app/lib/awhina-vision-conversation-bridge.test.ts app/lib/awhina-photo-intent.test.ts app/lib/awhina-intelligence-eval.test.ts app/lib/awhina-pending-action.test.ts app/lib/awhina-photo-quality-regression.test.ts app/lib/awhina-confirm-identity-regression.test.ts app/lib/awhina-domain-field-registry.test.ts app/lib/awhina-r34-rich-followup-regression.test.ts app/lib/awhina-knowledge-packs/knowledge-packs.test.ts app/lib/marketplace-knowledge/marketplace-knowledge.benchmark.test.ts",
    "test:awhina:live": "vitest run app/lib/sky-ai-live-eval.test.ts",
    "test:awhina:smoke": "node scripts/smoke-awhina-manual.cjs",
    "test:description-quality": "vitest run app/lib/awhina-description-quality-suite.test.ts app/lib/awhina-description-universal.test.ts app/lib/awhina-description-boundary-drift.test.ts app/lib/awhina-evidence-pipeline-regression.test.ts app/lib/awhina-bmw-extraction-regression.test.ts && npx tsx scripts/description-quality-tester.mts",
    "test:description-tester": "npx tsx scripts/description-quality-tester.mts",
    "test:description-tester:all": "npx tsx scripts/description-quality-tester.mts --all",
    "test:bmw-extraction": "vitest run app/lib/awhina-bmw-extraction-regression.test.ts",
    "test:evidence-pipeline": "vitest run app/lib/awhina-evidence-pipeline-regression.test.ts app/lib/awhina-bmw-extraction-regression.test.ts app/lib/awhina-new-listing-contamination.test.ts app/lib/awhina-seller-evidence.test.ts",
    "test:awhina:live:compare": "cross-env SKY_AI_COMPARE_PRODUCTION=1 vitest run app/lib/sky-ai-live-eval.test.ts",
    "test:rules": "vitest run tests/firestore-rules.test.ts tests/storage-rules.test.ts tests/security-launch-gates.test.ts",
    "test:rules:emulator": "firebase emulators:exec --only firestore,storage \"npm run test:rules\"",
    "git:sync": "powershell -ExecutionPolicy Bypass -File scripts/git-sync.ps1"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.55.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/dompurify": "^3.0.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.11",
    "firebase": "^10.12.2",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.1",
    "nodemailer": "^8.0.7",
    "nsfwjs": "^4.3.0",
    "openai": "^6.42.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resend": "^4.2.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "firebase-tools": "^15.27.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "undici": "6.28.0",
    "websocket-driver": "0.7.5"
  }
}
