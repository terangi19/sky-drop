rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny — everything must be explicitly allowed below.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper: image upload security — valid image MIME types and size limit
    function isImageUpload() {
      return request.resource.contentType.matches('image/jpeg')
        || request.resource.contentType.matches('image/png')
        || request.resource.contentType.matches('image/webp')
        || request.resource.contentType.matches('image/avif');
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isDocumentUpload() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('image/jpeg')
        || request.resource.contentType.matches('image/png')
        || request.resource.contentType.matches('image/webp');
    }

    function isDocumentUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isDigitalAssetUpload() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // Avatar and banner uploads — owner write, public read
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isImageUpload()
        && isImageUnder5MB();
    }
    match /banners/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isImageUpload()
        && isImageUnder5MB();
    }

    // Listing images — public read, owner write only
    match /listings/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isImageUpload()
        && isImageUnder5MB();
    }

    // ── KYC IDENTITY DOCUMENTS ────────────────────────────────────────────────
    // Extremely sensitive. ID photos must NEVER be accessible to other users.
    // Write: only the document owner (own uid folder), must be authenticated.
    // Read: only the document owner OR a server-side Admin SDK call.
    //   Client-side reads are blocked for everyone except the file owner.
    //   Admin reviews are done server-side via Admin SDK (bypasses these rules).
    match /kyc/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && isDocumentUpload()
        && isDocumentUnder10MB();
    }

    // Proof of address — same strict rules as KYC
    match /proof_of_address/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && isDocumentUpload()
        && isDocumentUnder10MB();
    }

    // Resumes — owner read/write only
    match /resumes/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('application/pdf')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Digital asset files — seller or confirmed buyer only, size limited
    match /digital-assets/{listingId}/{fileName} {
      allow read: if request.auth != null
        && (resource.metadata.sellerEmail == request.auth.token.email
          || resource.metadata.buyerEmail == request.auth.token.email);
      allow write: if request.auth != null
        && resource.metadata.sellerEmail == request.auth.token.email
        && isDigitalAssetUpload();
    }
  }
}
