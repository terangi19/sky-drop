rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Avatar and banner uploads
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Listing images
    match /listings/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Proof of address documents
    match /proof_of_address/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // KYC identity documents
    match /kyc/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Digital asset files (sold through marketplace)
    match /digital-assets/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
