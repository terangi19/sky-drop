rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Avatar and banner uploads
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Listing images
    match /listings/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Proof of address documents
    match /proof_of_address/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Resume uploads for job applications
    match /resumes/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Digital asset files (sold through marketplace)
    match /digital-assets/{listingId}/{fileName} {
      allow read: if request.auth != null
        && (resource.metadata.sellerEmail == request.auth.token.email
          || resource.metadata.buyerEmail == request.auth.token.email);
      allow write: if request.auth != null
        && resource.metadata.sellerEmail == request.auth.token.email;
    }
  }
}
